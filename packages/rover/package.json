{
  "name": "@rhq/rover",
  "version": "0.1.5",
  "description": "Clean, lightweight, TypeScript-first email intelligence library for React Native and JavaScript",
  "main": "./dist/index.js",
  "react-native": "./dist/react-native.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/react-native.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/react-native.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "default": "./dist/wasm.js"
    }
  },
  "files": [
    "dist",
    "eng/relay_rover.wasm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "email-intelligence",
    "email-parser",
    "otp-extractor",
    "typescript",
    "relay-rover",
    "wasm"
  ],
  "author": "Relay Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
